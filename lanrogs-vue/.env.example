# Copy this file to .env.local for local work, and add the same names in Vercel > Settings > Environment Variables.
# VITE_* values are visible in the browser by design. The anon key is meant to be public.
# NEVER put the Supabase "service_role" key here.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contact form e-mail copies. Use the FormSubmit URL with the private random ID (see DEPLOY.md), NOT your e-mail address:
# https://formsubmit.co/ajax/your-random-id
VITE_CONTACT_ENDPOINT=

# Optional: shown on the Contact page
VITE_GITHUB_URL=

# Your final public address (used for Google: sitemap, canonical links, link previews). No slash at the end.
# On Vercel you can leave this empty until you add a custom domain.
VITE_SITE_URL=
